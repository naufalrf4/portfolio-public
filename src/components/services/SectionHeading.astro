---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<div class="mb-10">
  <div class="mb-3 flex items-center gap-3" data-reveal>
    <span class="h-px w-8 bg-teal" aria-hidden="true"></span>
    <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-teal">{eyebrow}</span>
  </div>
  <h2
    id={id}
    class="font-display text-3xl font-bold tracking-tight text-text-primary md:text-4xl lg:text-5xl"
    data-reveal
    style={{ '--reveal-delay': '0.06s' }}
  >
    {title}
  </h2>
  <p
    class="mt-3 max-w-2xl text-base leading-relaxed text-text-secondary"
    data-reveal
    style={{ '--reveal-delay': '0.12s' }}
  >
    {description}
  </p>
</div>
