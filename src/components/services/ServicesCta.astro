---
import { ArrowRight, Download } from 'lucide-react';

interface Props {
  resumeUrl?: string | null;
}

const { resumeUrl } = Astro.props;
---

<section aria-label="More links" class="mb-14 flex flex-col gap-3 border-t border-line pt-8 text-sm md:mb-16" data-reveal>
  <p class="text-text-secondary">
    Want the full background?{' '}
    <a href="/about" class="font-medium text-teal transition-colors hover:text-amber">
      Read the story
    </a>
  </p>
  {
    resumeUrl && (
      <p class="text-text-secondary">
        Need the CV file?{' '}
        <a
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-medium text-teal transition-colors hover:text-amber"
        >
          Download it here
          <Download size={13} />
        </a>
      </p>
    )
  }
</section>

<section
  class="card-base relative flex flex-col items-start gap-6 overflow-hidden p-8 md:flex-row md:items-center md:justify-between md:p-12"
  data-reveal
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(90% 120% at 100% 0%, var(--teal-soft), transparent 60%);"
  />
  <div class="relative">
    <h2 class="font-display text-2xl font-bold tracking-tight text-text-primary md:text-4xl">
      Have something in mind?
    </h2>
    <p class="mt-3 max-w-xl text-text-secondary md:text-lg">
      One message with the problem in it is enough. You get back a straight read on scope, effort,
      and where I would start.
    </p>
  </div>
  <a href="/contact" class="group relative shrink-0">
    <span
      class="inline-flex items-center gap-3 rounded-lg bg-teal px-6 py-3.5 text-base font-semibold text-on-accent transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-0.5 group-hover:brightness-110 group-hover:shadow-[0_12px_32px_-10px_var(--teal-glow)] group-active:translate-y-0"
    >
      Send a message
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-bg/20 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1">
        <ArrowRight size={14} />
      </span>
    </span>
  </a>
</section>
