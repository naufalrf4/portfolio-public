---
import PageLayout from '../../layouts/PageLayout.astro';
import { AuthErrorContent } from '../../components/auth/AuthErrorContent';

const message = Astro.url.searchParams.get('message') || '';

const title = 'Auth Error';
const description = 'Something went wrong while signing in for the public guestbook flow.';---

<PageLayout title={title} description={description} canonicalUrl="/auth/error" noindex>
  <section class="min-h-screen px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <AuthErrorContent client:load message={message} />
    </div>
  </section>
</PageLayout>
