---
export const prerender = false;

import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { PageHero } from '@/components/shared';
import PageLayout from '@/layouts/PageLayout.astro';
import { Send } from 'lucide-react';

/**
 * The presentation deck used to live behind a client-side SPA
 * (/presentations-app/index.html?deck=slug) with an empty JS-filled <main>.
 * That has been retired: this page now reads the deck's own slide HTML
 * files at request time and renders their real content as plain,
 * server-rendered sections styled in this site's own visual language
 * (the deck's own presentation CSS - cqw units, slide theming - is
 * intentionally NOT reused here, since it's a different design system
 * built for a 16:9 slide canvas, not a scrolling page).
 *
 * There is currently only one deck ("sample-deck"). If more decks are
 * added later, this page will need a slug param and a listing again -
 * out of scope for this pass, which is specifically about retiring the
 * SPA for the single existing deck.
 */
const DECK_SLUG = 'sample-deck';
const DECK_DIR_CANDIDATES = [
  path.join(process.cwd(), 'dist', 'client', 'presentations-app', 'decks', DECK_SLUG),
  path.join(process.cwd(), 'public', 'presentations-app', 'decks', DECK_SLUG),
];

async function readDeckFile(relativePath: string): Promise<string | null> {
  for (const dir of DECK_DIR_CANDIDATES) {
    try {
      return await readFile(path.join(dir, relativePath), 'utf8');
    } catch {
      continue;
    }
  }
  return null;
}

function decodeEntities(value: string): string {
  return value
    .replace(/&amp;/g, '&')
    .replace(/&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
}

function stripTags(value: string): string {
  return decodeEntities(value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ')).trim();
}

function matchOne(html: string, re: RegExp): string {
  const m = html.match(re);
  return m ? stripTags(m[1]) : '';
}

interface InfoCard {
  title: string;
  desc: string;
}

function extractInfoCards(html: string): InfoCard[] {
  return [...html.matchAll(/<div class="infocard[^"]*">([\s\S]*?)<\/div>\s*<\/div>/g)].map((m) => ({
    title: matchOne(m[1], /<h3>([\s\S]*?)<\/h3>/),
    desc: matchOne(m[1], /<p>([\s\S]*?)<\/p>/),
  }));
}

interface DeckContent {
  cover: { name: string; accent: string; lead: string; chips: string[] } | null;
  agenda: { heading: string; lead: string; items: { number: string; title: string; desc: string }[] } | null;
  sectionLabel: string | null;
  stats: { heading: string; lead: string; items: { value: string; label: string }[] } | null;
  about: { heading: string; lead: string; badges: string[]; cards: InfoCard[] } | null;
  skills: { heading: string; tiles: { name: string; category: string }[] } | null;
  steps: {
    heading: string;
    lead: string;
    items: { number: string; title: string; desc: string }[];
  } | null;
  compare: {
    heading: string;
    columns: { header: string; lines: string[]; highlight: boolean }[];
  } | null;
  timeline: {
    heading: string;
    lead: string;
    phases: { period: string; title: string; desc: string }[];
  } | null;
  table: {
    heading: string;
    lead: string;
    headers: string[];
    rows: { name: string; category: string; stack: string; status: string; accent: boolean }[];
  } | null;
  media: {
    heading: string;
    lead: string;
    badges: string[];
    image: { src: string; alt: string } | null;
  } | null;
  qna: {
    heading: string;
    accent: string;
    lead: string;
    cards: InfoCard[];
  } | null;
  closing: { heading: string; accent: string; lead: string; badges: string[] } | null;
}

async function loadDeckContent(): Promise<DeckContent | null> {
  const manifestRaw = await readDeckFile('manifest.json');
  if (!manifestRaw) return null;

  let manifest: { slides?: string[] };
  try {
    manifest = JSON.parse(manifestRaw);
  } catch {
    return null;
  }
  if (!Array.isArray(manifest.slides) || manifest.slides.length === 0) return null;

  const slideCache = new Map<string, string>();
  async function slide(name: string): Promise<string> {
    if (slideCache.has(name)) return slideCache.get(name)!;
    const found = manifest.slides!.find((s) => s.endsWith(name));
    const html = found ? await readDeckFile(found) : null;
    slideCache.set(name, html ?? '');
    return html ?? '';
  }

  const content: DeckContent = {
    cover: null,
    agenda: null,
    sectionLabel: null,
    stats: null,
    about: null,
    skills: null,
    steps: null,
    compare: null,
    timeline: null,
    table: null,
    media: null,
    qna: null,
    closing: null,
  };

  try {
    const html = await slide('01-cover.html');
    const headingMatch = html.match(/<h1[^>]*>([\s\S]*?)<span class="accent">([\s\S]*?)<\/span>/);
    if (headingMatch) {
      content.cover = {
        name: stripTags(headingMatch[1]),
        accent: stripTags(headingMatch[2]),
        lead: matchOne(html, /<p class="lead[^"]*"[^>]*>([\s\S]*?)<\/p>/),
        chips: [...html.matchAll(/<span class="chip">([\s\S]*?)<\/span>/g)].map((m) => stripTags(m[1])),
      };
    }
  } catch {
    /* fall through, cover stays null */
  }

  try {
    const html = await slide('02-agenda.html');
    content.agenda = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      items: [...html.matchAll(/<div class="agenda-item">([\s\S]*?)<\/div>/g)].map((m) => ({
        number: matchOne(m[1], /<span class="an">([\s\S]*?)<\/span>/),
        title: matchOne(m[1], /<span class="at">([\s\S]*?)<\/span>/),
        desc: matchOne(m[1], /<span class="ad">([\s\S]*?)<\/span>/),
      })),
    };
  } catch {
    /* keep agenda null */
  }

  try {
    const html = await slide('03-divider.html');
    content.sectionLabel = matchOne(html, /<h1[^>]*>([\s\S]*?)<\/h1>/) || null;
  } catch {
    /* keep null */
  }

  try {
    const html = await slide('04-stat.html');
    content.stats = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      items: [...html.matchAll(/<div class="stat">([\s\S]*?)<\/div>/g)].map((m) => {
        const count = m[1].match(/data-count="([^"]*)"/)?.[1] ?? '';
        const suffix = m[1].match(/data-suffix="([^"]*)"/)?.[1] ?? '';
        return {
          value: `${count}${suffix}`,
          label: matchOne(m[1], /<span class="lab">([\s\S]*?)<\/span>/),
        };
      }),
    };
  } catch {
    /* keep stats null */
  }

  try {
    const html = await slide('05-split.html');
    content.about = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      badges: [...html.matchAll(/<span class="badge[^"]*">([\s\S]*?)<\/span>/g)].map((m) => stripTags(m[1])),
      cards: extractInfoCards(html),
    };
  } catch {
    /* keep about null */
  }

  try {
    const html = await slide('06-grid.html');
    content.skills = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      tiles: [...html.matchAll(/<div class="tile">([\s\S]*?)<\/div>/g)].map((m) => ({
        name: matchOne(m[1], /<h3>([\s\S]*?)<\/h3>/),
        category: matchOne(m[1], /<p>([\s\S]*?)<\/p>/),
      })),
    };
  } catch {
    /* keep skills null */
  }

  try {
    const html = await slide('07-steps.html');
    content.steps = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      items: [...html.matchAll(/<div class="step">([\s\S]*?)<\/div>/g)].map((m) => ({
        number: matchOne(m[1], /<span class="sn">([\s\S]*?)<\/span>/),
        title: matchOne(m[1], /<h3>([\s\S]*?)<\/h3>/),
        desc: matchOne(m[1], /<p>([\s\S]*?)<\/p>/),
      })),
    };
  } catch {
    /* keep steps null */
  }

  try {
    const html = await slide('08-compare.html');
    content.compare = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      columns: [...html.matchAll(/<div class="compare-col([^"]*)">([\s\S]*?)<\/div>/g)].map((m) => ({
        header: matchOne(m[2], /<span class="ch">([\s\S]*?)<\/span>/),
        lines: [...m[2].matchAll(/<span class="cline">([\s\S]*?)<\/span>/g)].map((l) => stripTags(l[1])),
        highlight: m[1].includes('hl'),
      })),
    };
  } catch {
    /* keep compare null */
  }

  try {
    const html = await slide('09-timeline.html');
    content.timeline = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      phases: [...html.matchAll(/<div class="phase[^"]*">([\s\S]*?)<\/div>/g)].map((m) => ({
        period: matchOne(m[1], /<span class="pp">([\s\S]*?)<\/span>/),
        title: matchOne(m[1], /<span class="pt">([\s\S]*?)<\/span>/),
        desc: matchOne(m[1], /<span class="pd">([\s\S]*?)<\/span>/),
      })),
    };
  } catch {
    /* keep timeline null */
  }

  try {
    const html = await slide('10-table.html');
    const rows = [...html.matchAll(/<tr>([\s\S]*?)<\/tr>/g)]
      .map((m) => m[1])
      .filter((row) => !row.includes('<th'))
      .map((row) => {
        const cells = [...row.matchAll(/<td[^>]*>([\s\S]*?)<\/td>/g)].map((c) => c[1]);
        const statusCell = cells[3] ?? '';
        return {
          name: stripTags(cells[0] ?? ''),
          category: stripTags(cells[1] ?? ''),
          stack: stripTags(cells[2] ?? ''),
          status: stripTags(statusCell),
          accent: /pill accent/.test(statusCell),
        };
      });
    content.table = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      headers: [...html.matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map((m) => stripTags(m[1])),
      rows,
    };
  } catch {
    /* keep table null */
  }

  try {
    const html = await slide('13-media.html');
    const imgMatch = html.match(/<img\s+src="([^"]*)"\s+alt="([^"]*)"/);
    content.media = {
      heading: matchOne(html, /<h2[^>]*>([\s\S]*?)<\/h2>/),
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      badges: [...html.matchAll(/<span class="badge[^"]*">([\s\S]*?)<\/span>/g)].map((m) => stripTags(m[1])),
      image: imgMatch ? { src: imgMatch[1], alt: decodeEntities(imgMatch[2]) } : null,
    };
  } catch {
    /* keep media null */
  }

  try {
    const html = await slide('11-qna.html');
    const bigMatch = html.match(/<div class="qbig">([\s\S]*?)<em>([\s\S]*?)<\/em><\/div>/);
    content.qna = {
      heading: bigMatch ? stripTags(bigMatch[1]) : '',
      accent: bigMatch ? stripTags(bigMatch[2]) : '',
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      cards: extractInfoCards(html),
    };
  } catch {
    /* keep qna null */
  }

  try {
    const html = await slide('12-closing.html');
    const headingMatch = html.match(/<h1[^>]*>([\s\S]*?)<span class="accent">([\s\S]*?)<\/span>/);
    content.closing = {
      heading: headingMatch ? stripTags(headingMatch[1]) : '',
      accent: headingMatch ? stripTags(headingMatch[2]) : '',
      lead: matchOne(html, /<p class="lead"[^>]*>([\s\S]*?)<\/p>/),
      badges: [...html.matchAll(/<span class="badge[^"]*">([\s\S]*?)<\/span>/g)].map((m) => stripTags(m[1])),
    };
  } catch {
    /* keep closing null */
  }

  return content;
}

const deck = await loadDeckContent();

const title = 'Presentations';
const description =
  'The current presentation deck from Naufal Rizqullah Firdaus, rendered as a single readable page rather than a slide-by-slide viewer.';
---

<PageLayout title={title} description={description}>
  <div class="min-h-screen py-12 md:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <PageHero
        eyebrow="Presentations"
        title="A few decks worth sharing"
        description="One deck, laid out as a page instead of a slide viewer. Everything from that deck, read top to bottom."
      />

      {
        !deck ? (
          <section class="card-base mx-auto max-w-xl p-8 text-center md:p-10" aria-labelledby="empty-deck-title">
            <h2 id="empty-deck-title" class="text-2xl font-bold text-text-primary">
              No deck available yet
            </h2>
            <p class="mt-3 leading-relaxed text-text-secondary">
              The presentation deck could not be read. Please check back soon.
            </p>
          </section>
        ) : (
          <div class="flex flex-col gap-20 md:gap-28">
            {deck.cover && (
              <section class="card-base p-8 md:p-12" aria-label="Deck cover">
                <p class="mb-4 font-mono text-xs uppercase tracking-[0.25em] text-teal">Cover slide</p>
                <h2 class="max-w-2xl font-display text-3xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary md:text-4xl">
                  {deck.cover.name} <span class="text-teal">{deck.cover.accent}</span>
                </h2>
                {deck.cover.lead && (
                  <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-secondary md:text-lg">
                    {deck.cover.lead}
                  </p>
                )}
                {deck.cover.chips.length > 0 && (
                  <div class="mt-6 flex flex-wrap gap-2.5">
                    {deck.cover.chips.map((chip) => (
                      <span class="mono-tag !text-xs">{chip}</span>
                    ))}
                  </div>
                )}
              </section>
            )}

            {deck.agenda && (
              <section aria-labelledby="agenda-heading">
                <h2 id="agenda-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.agenda.heading}
                </h2>
                {deck.agenda.lead && <p class="mt-3 max-w-2xl text-text-secondary">{deck.agenda.lead}</p>}
                <ol class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
                  {deck.agenda.items.map((item) => (
                    <li class="card-base flex items-start gap-4 p-5">
                      <span class="font-mono text-sm font-semibold text-teal">{item.number}</span>
                      <div>
                        <p class="font-semibold text-text-primary">{item.title}</p>
                        <p class="mt-1 text-sm text-text-secondary">{item.desc}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {deck.stats && (
              <section aria-labelledby="stats-heading">
                <h2 id="stats-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.stats.heading}
                </h2>
                {deck.stats.lead && <p class="mt-3 max-w-2xl text-text-secondary">{deck.stats.lead}</p>}
                <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
                  {deck.stats.items.map((stat) => (
                    <div class="card-base p-5 text-center">
                      <p class="font-display text-3xl font-bold text-teal md:text-4xl">{stat.value}</p>
                      <p class="mt-2 text-sm leading-snug text-text-secondary">{stat.label}</p>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {deck.about && (
              <section aria-labelledby="about-heading">
                <h2 id="about-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.about.heading}
                </h2>
                {deck.about.lead && <p class="mt-3 max-w-2xl text-text-secondary">{deck.about.lead}</p>}
                {deck.about.badges.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2.5">
                    {deck.about.badges.map((badge) => (
                      <span class="mono-tag !text-xs">{badge}</span>
                    ))}
                  </div>
                )}
                <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
                  {deck.about.cards.map((card) => (
                    <div class="card-base p-5">
                      <h3 class="font-semibold text-text-primary">{card.title}</h3>
                      <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">{card.desc}</p>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {deck.skills && (
              <section aria-labelledby="skills-heading">
                <h2 id="skills-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.skills.heading}
                </h2>
                <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
                  {deck.skills.tiles.map((tile) => (
                    <div class="card-base p-5">
                      <p class="font-semibold text-text-primary">{tile.name}</p>
                      <p class="mt-1 font-mono text-xs uppercase tracking-wider text-text-tertiary">
                        {tile.category}
                      </p>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {deck.steps && (
              <section aria-labelledby="steps-heading">
                <h2 id="steps-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.steps.heading}
                </h2>
                {deck.steps.lead && <p class="mt-3 max-w-2xl text-text-secondary">{deck.steps.lead}</p>}
                <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                  {deck.steps.items.map((step) => (
                    <div class="card-base p-5">
                      <span class="font-display text-2xl font-bold text-teal">{step.number}</span>
                      <h3 class="mt-2 font-semibold text-text-primary">{step.title}</h3>
                      <p class="mt-1.5 text-sm leading-relaxed text-text-secondary">{step.desc}</p>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {(deck.sectionLabel || deck.compare) && (
              <section aria-labelledby="compare-heading">
                {deck.sectionLabel && (
                  <p class="mb-2 text-sm font-medium text-text-tertiary">{deck.sectionLabel}</p>
                )}
                {deck.compare && (
                  <>
                    <h2 id="compare-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                      {deck.compare.heading}
                    </h2>
                    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
                      {deck.compare.columns.map((col) => (
                        <div
                          class:list={[
                            'card-base p-6',
                            col.highlight && 'border-teal/40 bg-[var(--teal-soft)]',
                          ]}
                        >
                          <p class="font-semibold text-text-primary">{col.header}</p>
                          <ul class="mt-4 flex flex-col gap-2.5">
                            {col.lines.map((line) => (
                              <li class="flex items-start gap-2 text-sm text-text-secondary">
                                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-teal" aria-hidden="true" />
                                {line}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </>
                )}
              </section>
            )}

            {deck.timeline && (
              <section aria-labelledby="timeline-heading">
                <h2 id="timeline-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.timeline.heading}
                </h2>
                {deck.timeline.lead && <p class="mt-3 max-w-2xl text-text-secondary">{deck.timeline.lead}</p>}
                <ol class="mt-8 flex flex-col gap-0 divide-y divide-line border-t border-line">
                  {deck.timeline.phases.map((phase) => (
                    <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
                      <span class="shrink-0 font-mono text-sm text-teal sm:w-28">{phase.period}</span>
                      <div>
                        <p class="font-semibold text-text-primary">{phase.title}</p>
                        <p class="text-sm text-text-secondary">{phase.desc}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {deck.table && (
              <section aria-labelledby="table-heading">
                <h2 id="table-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.table.heading}
                </h2>
                {deck.table.lead && <p class="mt-3 max-w-2xl text-text-secondary">{deck.table.lead}</p>}
                <div class="mt-8 overflow-x-auto">
                  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
                    <thead>
                      <tr class="border-b border-line">
                        {deck.table.headers.map((h) => (
                          <th class="pb-3 pr-4 font-mono text-xs uppercase tracking-wider text-text-tertiary">
                            {h}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {deck.table.rows.map((row) => (
                        <tr class="border-b border-line/60 last:border-b-0">
                          <td class="py-3 pr-4 font-medium text-text-primary">{row.name}</td>
                          <td class="py-3 pr-4 text-text-secondary">{row.category}</td>
                          <td class="py-3 pr-4 text-text-secondary">{row.stack}</td>
                          <td class="py-3 pr-4">
                            <span
                              class:list={[
                                'mono-tag !text-xs',
                                row.accent && '!text-teal !border-teal/30',
                              ]}
                            >
                              {row.status}
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            )}

            {deck.media && (
              <section aria-labelledby="media-heading">
                <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2">
                  <div>
                    <h2 id="media-heading" class="text-2xl font-bold text-text-primary md:text-3xl">
                      {deck.media.heading}
                    </h2>
                    {deck.media.lead && <p class="mt-3 text-text-secondary">{deck.media.lead}</p>}
                    {deck.media.badges.length > 0 && (
                      <div class="mt-5 flex flex-wrap gap-2.5">
                        {deck.media.badges.map((badge) => (
                          <span class="mono-tag !text-xs">{badge}</span>
                        ))}
                      </div>
                    )}
                  </div>
                  {deck.media.image && (
                    <div class="overflow-hidden rounded-2xl border border-line">
                      <img
                        src={deck.media.image.src}
                        alt={deck.media.image.alt}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}
                </div>
              </section>
            )}

            {deck.qna && (
              <section aria-labelledby="qna-heading">
                <h2 id="qna-heading" class="font-display text-2xl font-bold text-text-primary md:text-3xl">
                  {deck.qna.heading} <span class="italic text-teal">{deck.qna.accent}</span>
                </h2>
                {deck.qna.lead && <p class="mt-3 max-w-2xl text-text-secondary">{deck.qna.lead}</p>}
                <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
                  {deck.qna.cards.map((card) => (
                    <div class="card-base p-5">
                      <p class="font-semibold text-text-primary">{card.title}</p>
                      <p class="mt-1 text-sm text-text-secondary">{card.desc}</p>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {deck.closing && (
              <section class="card-base flex flex-col items-start gap-4 p-8 md:p-10" aria-labelledby="closing-heading">
                <h2 id="closing-heading" class="max-w-xl font-display text-2xl font-bold leading-tight text-text-primary md:text-3xl">
                  {deck.closing.heading} <span class="text-teal">{deck.closing.accent}</span>
                </h2>
                {deck.closing.lead && <p class="max-w-xl text-text-secondary">{deck.closing.lead}</p>}
                {deck.closing.badges.length > 0 && (
                  <div class="flex flex-wrap gap-2.5">
                    {deck.closing.badges.map((badge) => (
                      <span class="mono-tag !text-xs">{badge}</span>
                    ))}
                  </div>
                )}
                <a
                  href="/contact"
                  class="mt-2 inline-flex items-center gap-2 rounded-lg bg-teal px-6 py-3 text-base font-semibold text-bg transition-all duration-300 ease-out hover:-translate-y-0.5 hover:brightness-110 hover:shadow-[0_8px_24px_-8px_var(--teal-glow)]"
                >
                  <Send size={16} />
                  Send a message
                </a>
              </section>
            )}
          </div>
        )
      }
    </div>
  </div>
</PageLayout>
