---
import PageLayout from '../layouts/PageLayout.astro';
import { Guestbook } from '@/components/home/Guestbook';
import { getGuestbookEntries, ApiFetchFailedError } from '../lib/api';
import { serviceUnavailableResponse } from '../lib/site';

const turnstileSiteKey =
  process.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || '';

let guestbookData;
try {
  guestbookData = await getGuestbookEntries();
} catch (error) {
  if (error instanceof ApiFetchFailedError) {
    return serviceUnavailableResponse();
  }
  throw error;
}
const title = 'Guestbook';
const description = 'Read guestbook messages left for Naufal Rizqullah Firdaus by collaborators, classmates, builders, and visitors following his system engineering, automation, and real-world project work.';---

<PageLayout title={title} description={description}>
  <div class="homepage-reveal-blur" style="animation-delay:0.18s">
    <Guestbook
      client:load
      initialEntries={guestbookData.entries}
      turnstileSiteKey={turnstileSiteKey}
      mode="page"
      heroEyebrow="Guestbook"
      heroTitle="Leave a mark"
      heroDescription="Notes from people who stopped by. Read a few, or leave your own."
    />
  </div>
</PageLayout>
